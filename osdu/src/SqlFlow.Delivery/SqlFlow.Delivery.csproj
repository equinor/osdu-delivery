<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Delivery</RootNamespace>
    <Description>The OSDU delivery module: the OSDU, retrieval and cache flow kinds and their executors, mapping rendering, the OSDU protocols, the ledger over the osdu schema, the OSDU cache, templates and the lease-and-retry worker.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient 7 keeps Entra ID authentication in this package: without it every passwordless connection fails at open. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Yaml\SqlFlow.Yaml.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Execution\SqlFlow.Execution.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <!-- A repository's files are read where its last sync put them, or from its synced commit checked out as a run's is. -->
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Node\SqlFlow.Node.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Azure\SqlFlow.Azure.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Sources\SqlFlow.Sources.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery.Data\SqlFlow.Delivery.Data.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery.Search\SqlFlow.Delivery.Search.csproj" />
    <ProjectReference Include="..\SqlFlow.Delivery.Order\SqlFlow.Delivery.Order.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.Delivery.Tests" />
    <InternalsVisibleTo Include="SqlFlow.Delivery.ControlPlane.Tests" />
    <InternalsVisibleTo Include="SqlFlow.Delivery.Tools.SampleData" />
  </ItemGroup>

</Project>
