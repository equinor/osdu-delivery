{
  "name": "osdu-delivery",
  "displayName": "OSDU Delivery, powered by SQLFlow",
  "description": "Get any data into an OSDU® data platform. Configured, not coded: describe a delivery in YAML, see each record before it is sent, and trace every record that lands.",
  "version": "1.0.4",
  "publisher": "delta-forge",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#283e56",
    "theme": "dark"
  },
  "pricing": "Free",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TahirRiaz/osdu-delivery"
  },
  "homepage": "https://github.com/TahirRiaz/osdu-delivery/blob/main/osdu/docs/reference/guides/vscode.md",
  "bugs": {
    "url": "https://github.com/TahirRiaz/osdu-delivery/issues"
  },
  "keywords": [
    "osdu",
    "subsurface",
    "well",
    "wellbore",
    "well log",
    "seismic",
    "data delivery",
    "data pipeline",
    "yaml",
    "mapping",
    "lineage",
    "ledger",
    "language server",
    "mcp",
    "model context protocol",
    "ai assistant",
    "sqlflow"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Visualization",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sqlflow-flow",
    "onLanguage:yaml",
    "workspaceContains:**/*.flow.yaml",
    "workspaceContains:**/schedules.yaml",
    "workspaceContains:**/mappings/*.yaml",
    "workspaceContains:**/osdu-delivery.yaml",
    "onWebviewPanel:sqlflow.page"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "A workspace you have not trusted cannot choose the control plane your sign-in goes to, or the programs this extension runs.",
      "restrictedConfigurations": [
        "sqlflow.controlPlaneUrl",
        "sqlflow.guiUrl"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "sqlflow-flow",
        "aliases": [
          "OSDU Delivery document",
          "SQLFlow Flow",
          "flow.yaml"
        ],
        "extensions": [
          ".flow.yaml"
        ],
        "filenamePatterns": [
          "*.flow.yaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/flow.svg",
          "dark": "./resources/flow.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sqlflow-flow",
        "scopeName": "source.sqlflow-flow",
        "path": "./syntaxes/sqlflow-flow.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "OSDU Delivery",
      "properties": {
        "sqlflow.controlPlaneUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the control plane. Empty uses the one the MCP server was last given."
        },
        "sqlflow.lspBinaryPath": {
          "type": "string",
          "default": "",
          "description": "A build of the language server (sqlflow-lsp) to run instead of the packaged one.",
          "scope": "machine"
        },
        "sqlflow.mcpBinaryPath": {
          "type": "string",
          "default": "",
          "description": "A build of the MCP server (osdu-delivery-mcp) to run instead of the packaged one.",
          "scope": "machine"
        },
        "sqlflow.guiUrl": {
          "type": "string",
          "default": "",
          "description": "Public base URL of the GUI. With it, a page shown here offers itself in the browser, and links into the GUI are absolute."
        },
        "sqlflow.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The sqlflow command line. Empty uses the one this extension carries, else sqlflow on the PATH."
        },
        "sqlflow.recognizeDocuments": {
          "type": "boolean",
          "default": true,
          "description": "Open a YAML file that is a pipeline document as one, judged by its content. Repositories hold their flows as plain *.yaml files."
        }
      }
    },
    "commands": [
      {
        "command": "sqlflow.signIn",
        "title": "Sign In with the Browser",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.signInWithToken",
        "title": "Sign In with an Access Token",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.cancelSignIn",
        "title": "Cancel the Sign-In",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.signOut",
        "title": "Sign Out",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.setControlPlaneUrl",
        "title": "Set Control Plane URL",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.newFlow",
        "title": "New Document",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.validateFlow",
        "title": "Validate Document",
        "category": "OSDU Delivery",
        "icon": "$(check)"
      },
      {
        "command": "sqlflow.validateRepository",
        "title": "Validate Repository",
        "category": "OSDU Delivery",
        "icon": "$(checklist)"
      },
      {
        "command": "sqlflow.runVerb",
        "title": "Run a Command Line Verb on This Document",
        "category": "OSDU Delivery",
        "icon": "$(terminal)"
      },
      {
        "command": "sqlflow.searchDocs",
        "title": "Search Docs",
        "category": "OSDU Delivery",
        "icon": "$(book)"
      },
      {
        "command": "sqlflow.openDocsForKey",
        "title": "Open Docs for Key Under Cursor",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.refreshCatalog",
        "title": "Refresh",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.refreshRepository",
        "title": "Read the Workspace Again",
        "category": "OSDU Delivery",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.syncRepository",
        "title": "Sync Repository",
        "category": "OSDU Delivery",
        "icon": "$(sync)"
      },
      {
        "command": "sqlflow.openPipeline",
        "title": "Open Flow Page",
        "category": "OSDU Delivery",
        "icon": "$(preview)"
      },
      {
        "command": "sqlflow.openRun",
        "title": "Open Run",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.openPage",
        "title": "Open Page",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.openHome",
        "title": "Open Home",
        "category": "OSDU Delivery",
        "icon": "$(home)"
      },
      {
        "command": "sqlflow.openRuns",
        "title": "Open Runs",
        "category": "OSDU Delivery",
        "icon": "$(history)"
      },
      {
        "command": "sqlflow.openReports",
        "title": "Open Reports",
        "category": "OSDU Delivery",
        "icon": "$(graph)"
      },
      {
        "command": "sqlflow.showLineage",
        "title": "Open Lineage",
        "category": "OSDU Delivery",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sqlflow.compareWithSynced",
        "title": "Compare with Synced",
        "category": "OSDU Delivery",
        "icon": "$(diff)"
      },
      {
        "command": "sqlflow.openInGui",
        "title": "Open in the Browser",
        "category": "OSDU Delivery",
        "icon": "$(link-external)"
      },
      {
        "command": "sqlflow.setupMcp",
        "title": "Connect an AI Assistant",
        "category": "OSDU Delivery",
        "icon": "$(server)"
      },
      {
        "command": "sqlflow.shareWithOtherTools",
        "title": "Make the Command Line and Server Available to Other Tools",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.unshareFromOtherTools",
        "title": "Remove the Command Line and Server from Other Tools",
        "category": "OSDU Delivery"
      },
      {
        "command": "sqlflow.showStatus",
        "title": "Show Status",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.previewMapping",
        "title": "Preview Mapping",
        "category": "OSDU Delivery",
        "icon": "$(open-preview)"
      },
      {
        "command": "osduDelivery.scaffoldMapping",
        "title": "New Mapping from a Template",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.fetchTemplate",
        "title": "Fetch a Template into This Repository",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.openDelivery",
        "title": "Open Delivery",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.openTemplates",
        "title": "Open Templates",
        "category": "OSDU Delivery"
      },
      {
        "command": "osduDelivery.findRecord",
        "title": "Find a Record",
        "category": "OSDU Delivery",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlflow",
          "title": "OSDU Delivery",
          "icon": "./resources/osdu-delivery.svg"
        }
      ]
    },
    "views": {
      "sqlflow": [
        {
          "id": "sqlflow.sideBar",
          "name": "",
          "type": "webview",
          "contextualTitle": "OSDU Delivery",
          "icon": "./resources/osdu-delivery.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sqlflow.openRun",
          "when": "false"
        },
        {
          "command": "sqlflow.openPage",
          "when": "false"
        },
        {
          "command": "sqlflow.showStatus",
          "when": "false"
        },
        {
          "command": "sqlflow.cancelSignIn",
          "when": "sqlflow.signingIn"
        }
      ],
      "view/title": [
        {
          "command": "sqlflow.openHome",
          "when": "view == sqlflow.sideBar && sqlflow.signedIn",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "sqlflow.validateFlow",
          "when": "resourceLangId == sqlflow-flow",
          "group": "navigation"
        },
        {
          "command": "osduDelivery.previewMapping",
          "when": "resourceLangId == sqlflow-flow && osduDelivery.documentInFront == mapping",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "osduDelivery.previewMapping",
          "when": "resourceLangId == sqlflow-flow && osduDelivery.documentInFront == mapping",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openDocsForKey",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openPipeline",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.compareWithSynced",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openInGui",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.runVerb",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "osduDelivery.mcp",
        "label": "OSDU Delivery"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sqlflow",
        "required": [
          "verb",
          "file"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "description": "The command line verb."
          },
          "file": {
            "type": "string",
            "description": "The document it runs on."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "osduDelivery.start",
        "title": "Develop pipelines with OSDU Delivery",
        "description": "From sign-in to a first checked document.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in with Microsoft",
            "description": "Your browser opens the GUI, you sign in as you always do and approve the code. The editor and its assistants share the sign-in.\n[Sign In](command:sqlflow.signIn)",
            "completionEvents": [
              "onContext:sqlflow.signedIn"
            ],
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            }
          },
          {
            "id": "open",
            "title": "Open a repository",
            "description": "Flows, mappings, templates and schedules are recognised by what they hold, so a repository works as it is. The side bar lists them, each with what can be done with it.\n[Validate Repository](command:sqlflow.validateRepository)",
            "completionEvents": [
              "onCommand:sqlflow.validateRepository"
            ],
            "media": {
              "markdown": "resources/walkthrough/repository.md"
            }
          },
          {
            "id": "pages",
            "title": "Read the estate beside your files",
            "description": "Every page of the workbench opens in a tab of the editor: runs with their trace, lineage, mappings with the records they render. A mapping's preview follows the file as you save it.\n[Open Home](command:sqlflow.openHome)",
            "completionEvents": [
              "onCommand:sqlflow.openHome",
              "onCommand:osduDelivery.previewMapping"
            ],
            "media": {
              "markdown": "resources/walkthrough/pages.md"
            }
          },
          {
            "id": "assistant",
            "title": "Ask an assistant",
            "description": "The chat in this editor already has the estate's tools. Connect Claude Code, Cursor or Codex to the same server.\n[Connect an AI Assistant](command:sqlflow.setupMcp)",
            "completionEvents": [
              "onCommand:sqlflow.setupMcp"
            ],
            "media": {
              "markdown": "resources/walkthrough/assistant.md"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "osduDelivery.previewMapping",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceLangId == sqlflow-flow && osduDelivery.documentInFront == mapping"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "node --test \"test/*.test.ts\"",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npm run compile && node package.mjs",
    "test:integration": "node test/integration/runTest.mjs",
    "bundle:hosted": "npm --prefix ../../gui run build:hosted"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
