<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- The fake S3 store checks every SigV4 signature the route makes with the AWS SDK's own signer (AWSSDK.Core, at the
         AWSSDK.S3 version SQLFlow pins), so the route's signing is proven against AWS's implementation and not against
         itself. Tests only. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Sources\SqlFlow.Sources.csproj" />
    <!-- The chain suite asserts that lineage orders the estate's waves pre, then ingestion, then the OSDU flow, which is
         what the flow set collector and the graph builder decide. -->
    <ProjectReference Include="..\..\..\sqlflow\src\SqlFlow.Lineage\SqlFlow.Lineage.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery\SqlFlow.Delivery.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Data\SqlFlow.Delivery.Data.csproj" />
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Telemetry\SqlFlow.Delivery.Telemetry.csproj" />
    <!-- The module's command line verbs, run through SQLFlow's own module verb runner, for what they record and refuse. -->
    <ProjectReference Include="..\..\src\SqlFlow.Delivery.Cli\SqlFlow.Delivery.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample estate, linked into the test output in the shape the repository holds it: one folder for the source,
         holding its flows, the mappings they pin with the template folder holding the templates they fill, and the cache
         flow with the folder of sample records beside it. -->
    <Content Include="..\..\samples\welldb\mappings\**" Link="samples\welldb\mappings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\welldb\cache\**" Link="samples\welldb\cache\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\welldb\dictionaries\**" Link="samples\welldb\dictionaries\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\welldb\schedules.yaml" Link="samples\welldb\schedules.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The key census files the editor analyses the module's documents with, checked against the loaders. -->
    <Content Include="..\..\docs\census\*.json" Link="census\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\welldb\flows\**" Link="samples\welldb\flows\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The reference data the sample's records refer to: its flows, and the files its pre flows read. -->
    <Content Include="..\..\samples\welldb\reference\**" Link="samples\welldb\reference\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\welldb\templates\**" Link="samples\welldb\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\cache-records\**" Link="samples\cache-records\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The source's drop-off folder: what the pre-ingestion flows read and the payload files the delivery streams. The
         suites read the sample logs back from these files (SampleWellLogs), so they exercise what the repository holds. -->
    <Content Include="..\..\samples\welldb\data\**" Link="samples\welldb\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pinned OSDU contracts every route test checks its requests against. -->
    <Content Include="..\..\specs\**" Link="specs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The schemas the suites save beside the sample estate's, for the cases it does not carry (Fixtures/templates/README.md). -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fixture documents' flows deliver well logs beside their own kinds, with the sample's WellLog mapping, and read
         the sample's templates from a template folder of their own; Fixtures/templates, above both, holds the kinds the
         sample estate does not carry. -->
    <Content Include="..\..\samples\welldb\mappings\**" Link="Fixtures\documents\mappings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\welldb\templates\**" Link="Fixtures\documents\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator the sample estate's data is written with, so a suite can check that the committed files are exactly
         what it writes (SampleDataGeneratorTests). -->
    <Compile Include="..\..\tools\SampleData\SyntheticEstate.cs" Link="SampleData\SyntheticEstate.cs" />
    <Compile Include="..\..\tools\SampleData\OsduReferenceValues.cs" Link="SampleData\OsduReferenceValues.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the repository is, baked in when the suite is built: a suite built into an artifacts folder outside the
         repository cannot find it by walking up from its own binaries (RepositoryRoot). -->
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))" />
  </ItemGroup>

</Project>
