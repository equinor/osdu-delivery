{
  "name": "sqlflow",
  "displayName": "SQLFlow",
  "description": "Language support for SQLFlow pipeline documents, the workbench's pages in the editor, and an AI assistant.",
  "version": "0.2.0",
  "publisher": "business-iq",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sqlflow-flow",
    "onLanguage:yaml",
    "workspaceContains:**/*.flow.yaml",
    "workspaceContains:**/schedules.yaml",
    "onWebviewPanel:sqlflow.page"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sqlflow-flow",
        "aliases": [
          "SQLFlow Flow",
          "flow.yaml"
        ],
        "extensions": [
          ".flow.yaml"
        ],
        "filenamePatterns": [
          "*.flow.yaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/flow.svg",
          "dark": "./resources/flow.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sqlflow-flow",
        "scopeName": "source.sqlflow-flow",
        "path": "./syntaxes/sqlflow-flow.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SQLFlow",
      "properties": {
        "sqlflow.controlPlaneUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the control plane. Empty uses the one the MCP server was last given."
        },
        "sqlflow.lspBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the sqlflow-lsp binary. Empty uses the bundled binary.",
          "scope": "machine"
        },
        "sqlflow.mcpBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the sqlflow-mcp binary. Empty uses the bundled binary.",
          "scope": "machine"
        },
        "sqlflow.guiUrl": {
          "type": "string",
          "default": "",
          "description": "Public base URL of the GUI. With it, a page shown here offers itself in the browser, and links into the GUI are absolute."
        },
        "sqlflow.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The sqlflow command line. Empty uses the one this extension carries, else sqlflow on the PATH."
        },
        "sqlflow.recognizeDocuments": {
          "type": "boolean",
          "default": true,
          "description": "Open a YAML file that is a pipeline document as one, judged by its content. Repositories hold their flows as plain *.yaml files."
        }
      }
    },
    "commands": [
      {
        "command": "sqlflow.signIn",
        "title": "Sign In with the Browser",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.signInWithToken",
        "title": "Sign In with an Access Token",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.signOut",
        "title": "Sign Out",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.setControlPlaneUrl",
        "title": "Set Control Plane URL",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.newFlow",
        "title": "New Document",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.validateFlow",
        "title": "Validate Document",
        "category": "SQLFlow",
        "icon": "$(check)"
      },
      {
        "command": "sqlflow.validateRepository",
        "title": "Validate Repository",
        "category": "SQLFlow",
        "icon": "$(checklist)"
      },
      {
        "command": "sqlflow.runVerb",
        "title": "Run a Command Line Verb on This Document",
        "category": "SQLFlow",
        "icon": "$(terminal)"
      },
      {
        "command": "sqlflow.searchDocs",
        "title": "Search Docs",
        "category": "SQLFlow",
        "icon": "$(book)"
      },
      {
        "command": "sqlflow.openDocsForKey",
        "title": "Open Docs for Key Under Cursor",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.refreshCatalog",
        "title": "Refresh",
        "category": "SQLFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.refreshRepository",
        "title": "Read the Workspace Again",
        "category": "SQLFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlflow.syncRepository",
        "title": "Sync Repository",
        "category": "SQLFlow",
        "icon": "$(sync)"
      },
      {
        "command": "sqlflow.openPipeline",
        "title": "Open Flow Page",
        "category": "SQLFlow",
        "icon": "$(preview)"
      },
      {
        "command": "sqlflow.openRun",
        "title": "Open Run",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.openPage",
        "title": "Open Page",
        "category": "SQLFlow"
      },
      {
        "command": "sqlflow.openHome",
        "title": "Open Home",
        "category": "SQLFlow",
        "icon": "$(home)"
      },
      {
        "command": "sqlflow.openRuns",
        "title": "Open Runs",
        "category": "SQLFlow",
        "icon": "$(history)"
      },
      {
        "command": "sqlflow.showLineage",
        "title": "Open Lineage",
        "category": "SQLFlow",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sqlflow.compareWithSynced",
        "title": "Compare with Synced",
        "category": "SQLFlow",
        "icon": "$(diff)"
      },
      {
        "command": "sqlflow.openInGui",
        "title": "Open in the Browser",
        "category": "SQLFlow",
        "icon": "$(link-external)"
      },
      {
        "command": "sqlflow.setupMcp",
        "title": "Connect an AI Assistant",
        "category": "SQLFlow",
        "icon": "$(server)"
      },
      {
        "command": "sqlflow.showStatus",
        "title": "Show Status",
        "category": "SQLFlow"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlflow",
          "title": "SQLFlow",
          "icon": "./resources/flow.svg"
        }
      ]
    },
    "views": {
      "sqlflow": [
        {
          "id": "sqlflow.sideBar",
          "name": "",
          "type": "webview",
          "contextualTitle": "SQLFlow",
          "icon": "./resources/flow.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sqlflow.openRun",
          "when": "false"
        },
        {
          "command": "sqlflow.openPage",
          "when": "false"
        },
        {
          "command": "sqlflow.showStatus",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sqlflow.openHome",
          "when": "view == sqlflow.sideBar",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "sqlflow.validateFlow",
          "when": "resourceLangId == sqlflow-flow",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sqlflow.openDocsForKey",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openPipeline",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.compareWithSynced",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.openInGui",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        },
        {
          "command": "sqlflow.runVerb",
          "when": "resourceLangId == sqlflow-flow",
          "group": "sqlflow"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "sqlflow.mcp",
        "label": "SQLFlow"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sqlflow",
        "required": [
          "verb",
          "file"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "description": "The command line verb."
          },
          "file": {
            "type": "string",
            "description": "The document it runs on."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "test": "node --test \"test/*.test.ts\"",
    "bundle:hosted": "npm --prefix ../../gui run build:hosted"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.101.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "A workspace you have not trusted cannot choose the control plane your sign-in goes to, or the programs this extension runs.",
      "restrictedConfigurations": [
        "sqlflow.controlPlaneUrl",
        "sqlflow.guiUrl"
      ]
    },
    "virtualWorkspaces": false
  }
}
