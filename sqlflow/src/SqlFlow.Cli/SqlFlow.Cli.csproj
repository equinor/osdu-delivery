<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlFlow.Cli</RootNamespace>
    <!-- A library, so a product's program can be named sqlflow too: SqlFlow.Cli.Host is SQLFlow's own, and a product's
         runs CliHost.RunAsync with its modules. -->
    <Description>SQLFlow's command line: its verbs, and CliHost, which a program named sqlflow runs them with.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlFlow.Core.Tests" />
    <InternalsVisibleTo Include="SqlFlow.ControlPlane.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- The hosted services a worker node starts and stops with it (Hosting/NodeHostedServices.cs). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlFlow.Core\SqlFlow.Core.csproj" />
    <ProjectReference Include="..\SqlFlow.SqlServer\SqlFlow.SqlServer.csproj" />
    <ProjectReference Include="..\SqlFlow.Sources\SqlFlow.Sources.csproj" />
    <ProjectReference Include="..\SqlFlow.Yaml\SqlFlow.Yaml.csproj" />
    <ProjectReference Include="..\SqlFlow.Azure\SqlFlow.Azure.csproj" />
    <ProjectReference Include="..\SqlFlow.HealthCheck\SqlFlow.HealthCheck.csproj" />
    <ProjectReference Include="..\SqlFlow.Lineage\SqlFlow.Lineage.csproj" />
    <ProjectReference Include="..\SqlFlow.Providers\SqlFlow.Providers.csproj" />
    <ProjectReference Include="..\SqlFlow.SourceControl\SqlFlow.SourceControl.csproj" />
    <ProjectReference Include="..\SqlFlow.Orchestration\SqlFlow.Orchestration.csproj" />
    <ProjectReference Include="..\SqlFlow.Execution\SqlFlow.Execution.csproj" />
    <ProjectReference Include="..\SqlFlow.DuckDb\SqlFlow.DuckDb.csproj" />
    <ProjectReference Include="..\SqlFlow.Catalog\SqlFlow.Catalog.csproj" />
    <ProjectReference Include="..\SqlFlow.Node\SqlFlow.Node.csproj" />
  </ItemGroup>

</Project>
